<?xml version="1.0" encoding="UTF-8"?>
<!-- ERZEUGT von qmake aus config.xml.in – Änderungen bitte dort vornehmen -->
<!-- Installationssprache Deutsch (fest, unabhängig von der Windows-Sprache) -->
<Installer>
    <Name>VitaMeals</Name>
    <Version>0.3.0</Version>
    <Title>VitaMeals 0.3.0</Title>
    <Publisher>Michael Bergmann</Publisher>
    <ProductUrl>https://github.com/mbergmann-sh</ProductUrl>
    <StartMenuDir>VitaMeals</StartMenuDir>
    <TargetDir>C:/VitaMeals</TargetDir>
    <AdminTargetDir>C:/VitaMeals</AdminTargetDir>
    <AllowSpaceInPath>true</AllowSpaceInPath>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <RemoveTargetDir>true</RemoveTargetDir>
    <MaintenanceToolName>VitaMeals-Wartung</MaintenanceToolName>
    <InstallerApplicationIcon>vitameals</InstallerApplicationIcon>
    <InstallerWindowIcon>vitameals.png</InstallerWindowIcon>
    <Logo>logo.png</Logo>
    <Banner>banner.png</Banner>
    <Watermark>watermark.png</Watermark>
    <WizardStyle>Modern</WizardStyle>
    <WizardDefaultWidth>720</WizardDefaultWidth>
    <WizardDefaultHeight>520</WizardDefaultHeight>
    <RunProgram>@TargetDir@/VitaMeals.exe</RunProgram>
    <RunProgramDescription>VitaMeals starten</RunProgramDescription>
    <Translations>
        <Translation>ifw_de</Translation>
        <Translation>qt_de</Translation>
    </Translations>
    <ControlScript>controlscript.qs</ControlScript>
</Installer>

